<div class="container">
  <h2>구매 내역 수정</h2>
  <form action="/purchase/update_process" method="post">
    <input type="hidden" name="purchase_id" value="<%= purchase.purchase_id %>">

    <div class="mb-3">
      <label class="form-label" for="loginid">고객</label>
      <select name="loginid" id="loginid">
        <% people.forEach((person) => { %>
          <option value="<%= person.loginid %>" <%= person.loginid === purchase.loginid ? 'selected' : '' %>><%= person.loginid %> : <%= person.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="mb-3">
      <label class="form-label" for="prod_id">상품</label>
      <select name="prod_id" id="prod_id">
        <% products.forEach((product) => { %>
          <option value="<%= product.prod_id %>" <%= Number(product.prod_id) === Number(purchase.prod_id) ? 'selected' : '' %>><%= product.prod_id %> : <%= product.name %></option>
        <% }) %>
      </select>
    </div>

    <table>
      <tr>
        <td>
          <div class="mb-3">
            <label class="form-label" for="date">날짜</label>
            <input class="form-control" id="date" type="text" name="date" value="<%= purchase.date %>" readonly style="width:300px;background-color:rgb(204,203,203);">
          </div>
        </td>
        <td>
          <div class="mb-3">
            <label class="form-label" for="price">가격</label>
            <input class="form-control" id="price" type="text" name="price" value="<%= purchase.price %>" style="width:300px;">
          </div>
        </td>
      </tr>
      <tr>
        <td>
          <div class="mb-3">
            <label class="form-label" for="point">포인트</label>
            <input class="form-control" id="point" type="text" name="point" value="<%= purchase.point %>" style="width:300px;">
          </div>
        </td>
        <td>
          <div class="mb-3">
            <label class="form-label" for="qty">수량</label>
            <input class="form-control" id="qty" type="number" name="qty" value="<%= purchase.qty %>" style="width:300px;">
          </div>
        </td>
      </tr>
    </table>

    <div class="mb-3">
      <label class="form-label" for="total">총액</label>
      <input class="form-control" id="total" type="text" name="total" value="<%= purchase.total %>" style="width:300px;">
    </div>

    <div class="mb-3">
      <label class="form-label" for="payYN">지불여부</label>
      <select name="payYN" id="payYN">
        <option value="Y" <%= purchase.payYN === 'Y' ? 'selected' : '' %>>YES</option>
        <option value="N" <%= purchase.payYN !== 'Y' ? 'selected' : '' %>>NO</option>
      </select>
    </div>

    <div class="mb-3">
      <label class="form-label" for="cancel">취소여부</label>
      <select name="cancel" id="cancel">
        <option value="Y" <%= purchase.cancel === 'Y' ? 'selected' : '' %>>YES</option>
        <option value="N" <%= purchase.cancel !== 'Y' ? 'selected' : '' %>>NO</option>
      </select>
    </div>

    <button class="btn btn-outline-primary btn-sm" type="submit">수정</button>
    <a href="/purchase/view"><button class="btn btn-outline-primary btn-sm" type="button">구매 목록 돌아가기</button></a>
  </form>
</div>
